#!/usr/bin/env bash
# The one command that stands for "the tree is sound": the reference layer,
# the word budgets and every SKILL.md's frontmatter (scripts/check-links.py),
# plus the portable, Claude Code and Codex plugin/marketplace manifests
# (scripts/check-plugin.py). External Claude validation runs when available;
# only the root CLAUDE.md development-contract warning is permitted.
#
# Both checks run regardless of whether the first one fails, so one call
# surfaces everything wrong at once. Structural package checks require only
# python3, so they also work in a Codex-only environment. A missing Claude CLI
# is reported as an explicit skip of the external validation.
#
# Usage: scripts/check
# Exit:  0 both checks passed · 1 either failed
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

status=0

python3 "$script_dir/check-links.py" || status=1

python3 "$script_dir/check-plugin.py" "$repo_root" || status=1

exit "$status"
