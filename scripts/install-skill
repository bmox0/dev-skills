#!/usr/bin/env python3
"""Install only the dev-skills entry skill for a native client."""

import argparse
import os
from pathlib import Path
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", choices=("codex", "claude"))
    args = parser.parse_args()
    home = Path.home()
    root = (home / ".agents" if args.host == "codex"
            else Path(os.environ.get("CLAUDE_CONFIG_DIR") or home / ".claude").expanduser())
    source = Path(__file__).resolve().parents[1] / "ds-cli-skill/SKILL.md"
    target = root / "skills" / source.parent.name / source.name
    contents = source.read_bytes()
    if target.parent.is_symlink():
        raise OSError(f"{target.parent} is a symlink; move it aside before installing")
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent) as staged:
        staged.write(contents)
        staged.flush()
        try:
            os.link(staged.name, target)
        except FileExistsError:
            if target.is_symlink() or not target.is_file() or target.read_bytes() != contents:
                raise OSError(f"{target} already exists and differs; move it aside before installing") from None
    print(f"Installed {target}")


if __name__ == "__main__":
    try:
        main()
    except OSError as error:
        sys.exit(f"install-skill: {error}")
