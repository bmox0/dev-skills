#!/usr/bin/env python3
"""Run every shell test, or just one discovered path."""
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
from itertools import islice
import os
from pathlib import Path
import subprocess
import sys
import textwrap


def run(path):
    try:
        result = subprocess.run([path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, errors="replace")
    except OSError as error:
        return False, str(error)
    return result.returncode == 0, result.stdout


def main():
    os.chdir(Path(__file__).resolve().parents[1])
    files = sorted(p.as_posix() for p in Path("test").rglob("*.test.sh") if p.is_file() and not p.is_symlink())
    if len(sys.argv) > 1:
        target = sys.argv[1]
        if target not in files:
            print(f"scripts/test: not a test file: {target}", file=sys.stderr)
            return 1
        files = [target]
    workers = min(8, os.cpu_count() or 1)
    pending = iter(sorted(files, key=lambda path: -Path(path).stat().st_size))
    reporting = iter(files)
    next_report = next(reporting, None)
    results = {}
    failed = False
    pool = ThreadPoolExecutor(max_workers=workers)
    try:
        jobs = {pool.submit(run, path): path for path in islice(pending, workers)}
        while jobs:
            done, _ = wait(jobs, return_when=FIRST_COMPLETED)
            for job in done:
                results[jobs.pop(job)] = job.result()
            for path in islice(pending, len(done)):
                jobs[pool.submit(run, path)] = path
            while next_report in results:
                passed, output = results.pop(next_report)
                print(f"{'ok  ' if passed else 'FAIL'}  {next_report}", flush=True)
                if not passed:
                    failed = True
                    print(textwrap.indent(output.rstrip(), "      "), flush=True)
                next_report = next(reporting, None)
    except KeyboardInterrupt:
        return 130
    finally:
        pool.shutdown(cancel_futures=True)
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
