#!/usr/bin/env bash
# The behavioural net's runner. No external dependency, to match
# scripts/check: bash and python3 standard library only.
#
# Plain mode discovers and runs every test/**/*.test.sh (executed as its own
# process, so one file's `set -e` cannot end the run), prints one line per
# file, and exits 0 only if every file passed.
#
# Given a PATH instead, runs only that one file and prints only its line. A PATH that isn't a discovered test file is a loud failure naming it,
# never a silent fallback to the whole suite.
#
# Usage: scripts/test [PATH]
# Exit:  0 everything held (or the one named file passed)
#        1 something didn't (a failing file, an unrecognised PATH, ...)
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"

status=0

discover_sh() {
  find test -type f -name '*.test.sh' 2>/dev/null | LC_ALL=C sort
}

report_result() {
  local f="$1" rc="$2" out="$3"
  if [ "$rc" -eq 0 ]; then
    echo "ok    $f"
  else
    echo "FAIL  $f"
    printf '%s\n' "$out" | sed 's/^/      /'
    status=1
  fi
}

run_sh_file() {
  local f="$1" out rc
  out=$("$f" 2>&1)
  rc=$?
  report_result "$f" "$rc" "$out"
}

run_all() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    run_sh_file "$f"
  done < <(discover_sh)
}

# run_one PATH — the single-file mode: PATH must equal (exactly, as printed
# by discover_sh) one of the discovered test files. Anything else
# is an unrecognised PATH — reported and non-zero, never a fallback to
# run_all, which is the exact bug this mode exists to fix.
run_one() {
  local target="$1" f found=0

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$f" = "$target" ]; then
      found=1
      run_sh_file "$f"
    fi
  done < <(discover_sh)

  if [ "$found" -eq 0 ]; then
    echo "scripts/test: not a test file: $target" >&2
    status=1
  fi
}

if [ -n "${1:-}" ]; then
  run_one "$1"
else
  run_all
fi

exit "$status"
