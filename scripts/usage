#!/usr/bin/env python3
"""Measure sessions through an explicitly selected transcript-format adapter.

Usage: scripts/usage --source NAME [--root DIR] [--project TEXT] [--since YYYY-MM-DD]
                     [--json] [--messages FILE]
Dates are UTC; active hours count gaps shorter than 15 minutes.
"""

import argparse
import collections
import datetime
import importlib.util
import json
import os
import sys

sys.dont_write_bytecode = True

from adapter import adapter_path


def main(argv=None):
    parser = argparse.ArgumentParser(prog="usage", description=__doc__.split("\n\n")[0])
    parser.add_argument("--source", required=True, help="transcript format adapter name")
    parser.add_argument("--root", help="transcript directory (defaults to the selected source)")
    parser.add_argument("--project", help="only projects whose name contains this")
    parser.add_argument("--since", help="only sessions starting on or after this UTC date, YYYY-MM-DD")
    parser.add_argument("--json", action="store_true", help="one record per session, as JSON")
    parser.add_argument("--messages", help="also write every human message to this file")
    args = parser.parse_args(argv)
    try:
        path = adapter_path(args.source, "usage.py")
        spec = importlib.util.spec_from_file_location("usage_adapter", path)
        source = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(source)
    except (ValueError, OSError, ImportError) as exc:
        parser.error(f"--source {args.source!r}: {exc}")
    if args.root is None:
        args.root = source.default_root()

    if args.since:
        try:
            datetime.datetime.strptime(args.since, "%Y-%m-%d")
        except ValueError:
            print(f"usage: --since takes YYYY-MM-DD, got {args.since!r}", file=sys.stderr)
            return 2
        if len(args.since) != 10:
            print(f"usage: --since takes YYYY-MM-DD, got {args.since!r}", file=sys.stderr)
            return 2
    if args.messages and not os.path.isdir(os.path.dirname(os.path.abspath(args.messages))):
        print(f"usage: no directory for {args.messages}", file=sys.stderr)
        return 2
    if not os.path.isdir(args.root):
        print(f"usage: no transcripts at {args.root}", file=sys.stderr)
        return 2

    records, messages = [], []
    sessions = source.sessions(args.root, args.project)
    for record, msgs in sessions:
        if record is None or (args.project and args.project not in record["project"]):
            continue
        if args.since and record["start"] < args.since:
            continue
        records.append(record)
        messages.extend(msgs)
    records.sort(key=lambda r: (r["project"], r["start"]))

    if args.messages:
        with open(args.messages, "w", encoding="utf-8") as f:
            for project, sid, t, text in sorted(messages, key=lambda m: (m[0], m[2] or datetime.datetime.min.replace(tzinfo=datetime.timezone.utc))):
                f.write(f"=== {project} {sid} {t.strftime('%Y-%m-%d %H:%M') if t else ''}\n{text[:1500]}\n")

    if args.json:
        json.dump([{k: v for k, v in r.items() if k != "_exact"} for r in records],
                  sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 0

    totals = collections.OrderedDict()
    for r in records:
        t = totals.setdefault(r["project"], collections.Counter())
        t["sessions"] += 1
        for key in ("nuser", "nsubs"):
            t[key] += r[key]
        for key, value in r["_exact"].items():
            t[key] += value
    columns = ("sessions", "wall_h", "active_h", "nuser", "out_k", "nsubs", "sub_h")
    print("\t".join(("project",) + columns))
    for project, t in totals.items():
        cells = [str(int(t[c])) if c == "out_k" else str(round(t[c], 1)) for c in columns]
        print("\t".join([project] + cells))
    return 0


if __name__ == "__main__":
    try:
        code = main()
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 0
    sys.exit(code)
