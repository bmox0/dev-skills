#!/usr/bin/env python3
"""Measure Claude Code or Codex sessions from their transcripts.

Reads Claude transcripts under ~/.claude/projects, or Codex rollouts under
$CODEX_HOME/sessions (default ~/.codex/sessions), with --root overriding either.
Reports per session: wall and active hours, human messages, interrupts, skills and slash
commands used, subagents dispatched, tokens, and subagent hours. Active hours
sum the gaps between main-thread events shorter than 15 minutes; subagent hours
are first-to-last timestamp per subagent transcript, summed. Claude message usage
appears on each content-block line, repeated in main transcripts and
still growing in subagent ones, so each message id counts once, at its largest.
Dates are UTC.

Usage: scripts/usage [--source claude|codex] [--root DIR] [--project TEXT] [--since YYYY-MM-DD]
                     [--json] [--messages FILE]
"""

import argparse
import collections
import datetime
import glob
import json
import os
import re
import sys

GAP_SECONDS = 900


def timestamp(event):
    t = event.get("timestamp")
    if not isinstance(t, str) or not t:
        return None
    try:
        parsed = datetime.datetime.fromisoformat(t.replace("Z", "+00:00"))
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=datetime.timezone.utc)


def user_text(event):
    m = event.get("message")
    if not isinstance(m, dict) or m.get("role") != "user":
        return None
    content = m.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        if any(isinstance(x, dict) and x.get("type") == "tool_result" for x in content):
            return None
        parts = [x.get("text", "") for x in content if isinstance(x, dict) and x.get("type") == "text"]
        parts = [part for part in parts if isinstance(part, str)]
        return "\n".join(parts) if parts else None
    return None


def active_seconds(times):
    times = sorted(t for t in times if t)
    return sum(
        (b - a).total_seconds()
        for a, b in zip(times, times[1:])
        if (b - a).total_seconds() < GAP_SECONDS
    )


def events(path, start=0):
    with open(path, encoding="utf-8", errors="replace") as f:
        for ordinal, line in enumerate(f):
            if ordinal < start:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict):
                yield event


TOKEN_FIELDS = ("output_tokens", "input_tokens", "cache_read_input_tokens",
                "cache_creation_input_tokens")


def n(value):
    return value if isinstance(value, (int, float)) else 0


class Tokens:
    def __init__(self):
        self.by_id = {}
        self.anonymous = collections.Counter()

    def add(self, message):
        u = message.get("usage")
        if not isinstance(u, dict):
            return
        mid = message.get("id")
        if not mid:
            for field in TOKEN_FIELDS:
                self.anonymous[field] += n(u.get(field))
            return
        best = self.by_id.setdefault(mid, collections.Counter())
        for field in TOKEN_FIELDS:
            best[field] = max(best[field], n(u.get(field)))

    def total(self, *fields):
        return sum(self.anonymous[f] + sum(c[f] for c in self.by_id.values()) for f in fields)


def read_session(project, path):
    sid = os.path.basename(path)[:-len(".jsonl")]
    title = None
    times = []
    skills, agents, cmds = collections.Counter(), collections.Counter(), collections.Counter()
    messages = []
    interrupts = 0
    tokens = Tokens()
    for event in events(path):
        if event.get("type") == "ai-title":
            title = event.get("aiTitle") or event.get("title") or title
        if event.get("isSidechain"):
            continue
        t = timestamp(event)
        if t:
            times.append(t)
        m = event.get("message")
        if event.get("type") == "assistant" and isinstance(m, dict):
            tokens.add(m)
            content = m.get("content")
            for c in content if isinstance(content, list) else []:
                if isinstance(c, dict) and c.get("type") == "tool_use":
                    tool_input = c.get("input") if isinstance(c.get("input"), dict) else {}
                    if c.get("name") == "Skill":
                        skills[tool_input.get("skill")] += 1
                    if c.get("name") in ("Agent", "Task"):
                        agents[tool_input.get("subagent_type", "?")] += 1
        if event.get("type") != "user":
            continue
        text = user_text(event)
        if text is None:
            continue
        if "[Request interrupted" in text:
            interrupts += 1
            continue
        for name in re.findall(r"<command-name>/?([^<]+)</command-name>", text):
            cmds[name.strip()] += 1
        if event.get("isMeta"):
            continue
        if text.startswith("<") and any(k in text for k in (
                "command-name", "local-command", "system-reminder", "task-notification")):
            if "command-name" in text:
                args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
                names = " ".join(re.findall(r"<command-name>([^<]+)", text))
                messages.append((t, "CMD " + names + " " + (args.group(1)[:300] if args else "")))
            continue
        messages.append((t, text))

    subs = glob.glob(os.path.join(os.path.dirname(path), sid, "subagents", "*.jsonl"))
    sub_out = 0
    sub_seconds = 0.0
    for sub in subs:
        st = []
        sub_tokens = Tokens()
        for event in events(sub):
            t = timestamp(event)
            if t:
                st.append(t)
            m = event.get("message")
            if event.get("type") == "assistant" and isinstance(m, dict):
                sub_tokens.add(m)
        sub_out += sub_tokens.total("output_tokens")
        if st:
            sub_seconds += (max(st) - min(st)).total_seconds()

    if not times:
        return None, []
    out_tokens = tokens.total("output_tokens")
    in_tokens = tokens.total("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
    wall = (max(times) - min(times)).total_seconds()
    active = active_seconds(times)
    record = {
        "project": project,
        "sid": sid[:8],
        "title": title,
        "start": min(times).strftime("%Y-%m-%d %H:%M"),
        "wall_h": round(wall / 3600, 1),
        "active_h": round(active / 3600, 1),
        "nuser": len(messages),
        "interrupts": interrupts,
        "skills": dict(skills),
        "cmds": dict(cmds),
        "agents": dict(agents),
        "out_k": out_tokens // 1000,
        "in_M": round(in_tokens / 1e6, 1),
        "nsubs": len(subs),
        "sub_out_k": sub_out // 1000,
        "sub_h": round(sub_seconds / 3600, 1),
        "_exact": {"wall_h": wall / 3600, "active_h": active / 3600, "sub_h": sub_seconds / 3600,
                   "out_k": out_tokens / 1000},
    }
    return record, [(project, sid[:8], t, text) for t, text in messages]


def read_codex_session(path):
    first = next(events(path), {})
    meta = first.get("payload")
    if first.get("type") != "session_meta" or not isinstance(meta, dict) or not meta.get("id"):
        return None
    source = meta.get("source")
    subagent = source.get("subagent") if isinstance(source, dict) else None
    spawn = subagent.get("thread_spawn", {}) if isinstance(subagent, dict) else {}
    spawn = spawn if isinstance(spawn, dict) else {}
    parent = meta.get("parent_thread_id") or spawn.get("parent_thread_id")
    start = meta.get("subagent_history_start_ordinal", 0)
    start = start if isinstance(start, int) and start >= 0 else 0
    times = [timestamp(meta)] if timestamp(meta) else []
    responses, human_events = [], []
    seen_messages, seen_calls = set(), set()
    agents, totals = collections.Counter(), collections.Counter()
    turn, interrupts = None, 0
    for event in events(path, start):
        p = event.get("payload")
        if not isinstance(p, dict) or event.get("type") == "session_meta":
            continue
        t = timestamp(event)
        if t:
            times.append(t)
        kind = p.get("type")
        if event.get("type") == "turn_context" or kind == "task_started":
            turn = p.get("turn_id", turn)
        if event.get("type") == "event_msg":
            if kind == "token_count":
                info = p.get("info")
                usage = info.get("total_token_usage") if isinstance(info, dict) else None
                if isinstance(usage, dict):
                    # Cached input and reasoning output are subsets of these cumulative counters.
                    for field in ("input_tokens", "output_tokens"):
                        totals[field] = max(totals[field], n(usage.get(field)))
            elif kind == "turn_aborted":
                interrupts += 1
            elif kind == "user_message" and isinstance(p.get("message"), str):
                human_events.append((p.get("turn_id", turn), t, p["message"]))
        if event.get("type") != "response_item":
            continue
        if kind == "function_call" and p.get("name", "").split(".")[-1] == "spawn_agent":
            cid = p.get("call_id") or p.get("id")
            if cid and cid in seen_calls:
                continue
            if cid:
                seen_calls.add(cid)
            try:
                args = json.loads(p.get("arguments", "{}"))
            except (ValueError, TypeError):
                args = {}
            agents[args.get("agent_type", "?") if isinstance(args, dict) else "?"] += 1
        if kind != "message" or p.get("role") != "user":
            continue
        mid = p.get("id")
        if mid and mid in seen_messages:
            continue
        if mid:
            seen_messages.add(mid)
        metadata = p.get("internal_chat_message_metadata_passthrough")
        metadata = metadata if isinstance(metadata, dict) else {}
        kinds = metadata.get("content_item_kinds", [])
        provenance = metadata.get("content_item_metadata", [])
        content = p.get("content")
        parts = []
        human = False
        for i, part in enumerate(content if isinstance(content, list) else []):
            if not isinstance(part, dict):
                continue
            if kinds or provenance:
                k = kinds[i] if i < len(kinds) else ""
                origin = provenance[i].get("provenance", {}) if i < len(provenance) else {}
                if not k.startswith("user.") and origin.get("type") != "user":
                    continue
            text = part.get("text", "")
            if not isinstance(text, str) or text.startswith(("# AGENTS.md", "<environment_context>",
                                                             "<permissions instructions>")):
                continue
            human = True
            parts.append(text)
        if human:
            responses.append((metadata.get("turn_id", turn), t, "\n".join(parts)))
    # Some rollouts store both representations of the same human message.
    duplicates = collections.Counter((turn, text) for turn, _, text in human_events)
    messages = [(t, text) for _, t, text in human_events]
    for turn, t, text in responses:
        if duplicates[(turn, text)]:
            duplicates[(turn, text)] -= 1
        else:
            messages.append((t, text))
    if not times:
        return None
    project, sid = meta.get("cwd", "?"), meta["id"]
    cmds = collections.Counter()
    for _, text in messages:
        command = re.match(r"^/([\w:-]+)(?:\s|$)", text)
        if command:
            cmds[command.group(1)] += 1
    wall = (max(times) - min(times)).total_seconds() / 3600
    active = active_seconds(times) / 3600
    record = {
        "project": project, "sid": sid[:8], "title": None,
        "start": min(times).astimezone(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M"),
        "wall_h": round(wall, 1), "active_h": round(active, 1), "nuser": len(messages),
        "interrupts": interrupts, "skills": {}, "cmds": dict(cmds), "agents": dict(agents),
        "out_k": totals["output_tokens"] // 1000, "in_M": round(totals["input_tokens"] / 1e6, 1),
        "nsubs": 0, "sub_out_k": 0, "sub_h": 0.0,
        "_exact": {"wall_h": wall, "active_h": active, "sub_h": 0.0,
                   "out_k": totals["output_tokens"] / 1000},
    }
    return sid, parent, bool(parent or subagent or meta.get("thread_source") == "subagent"), record, messages


def codex_sessions(root):
    sessions = {}
    for path in sorted(glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True)):
        session = read_codex_session(path)
        if session:
            sessions[session[0]] = session
    for sid, parent, child, record, _ in sessions.values():
        if not child:
            continue
        visited = {sid}
        while parent in sessions and parent not in visited:
            visited.add(parent)
            _, ancestor, is_child, owner, _ = sessions[parent]
            if not is_child:
                owner["nsubs"] += 1
                owner["sub_out_k"] += record["_exact"]["out_k"]
                owner["_exact"]["sub_h"] += record["_exact"]["wall_h"]
                break
            parent = ancestor
    for sid, _, child, record, messages in sessions.values():
        if not child:
            record["sub_out_k"] = int(record["sub_out_k"])
            record["sub_h"] = round(record["_exact"]["sub_h"], 1)
            yield record, [(record["project"], sid[:8], t, text) for t, text in messages]


def main(argv=None):
    parser = argparse.ArgumentParser(prog="usage", description=__doc__.split("\n\n")[0])
    parser.add_argument("--source", choices=("claude", "codex"), default="claude")
    parser.add_argument("--root", help="transcript directory (defaults to the selected source)")
    parser.add_argument("--project", help="only projects whose directory name or Codex cwd contains this")
    parser.add_argument("--since", help="only sessions starting on or after this UTC date, YYYY-MM-DD")
    parser.add_argument("--json", action="store_true", help="one record per session, as JSON")
    parser.add_argument("--messages", help="also write every human message to this file")
    args = parser.parse_args(argv)
    if args.root is None:
        args.root = (os.path.join(os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex")), "sessions")
                     if args.source == "codex" else os.path.expanduser("~/.claude/projects"))

    if args.since:
        try:
            datetime.datetime.strptime(args.since, "%Y-%m-%d")
        except ValueError:
            print(f"usage: --since takes YYYY-MM-DD, got {args.since!r}", file=sys.stderr)
            return 2
        if len(args.since) != 10:
            print(f"usage: --since takes YYYY-MM-DD, got {args.since!r}", file=sys.stderr)
            return 2
    if args.messages and not os.path.isdir(os.path.dirname(os.path.abspath(args.messages))):
        print(f"usage: no directory for {args.messages}", file=sys.stderr)
        return 2
    if not os.path.isdir(args.root):
        print(f"usage: no transcripts at {args.root}", file=sys.stderr)
        return 2

    records, messages = [], []
    if args.source == "codex":
        sessions = codex_sessions(args.root)
    else:
        sessions = (read_session(project, path)
                    for project in sorted(os.listdir(args.root))
                    if not args.project or args.project in project
                    for path in sorted(glob.glob(os.path.join(args.root, project, "*.jsonl"))))
    for record, msgs in sessions:
        if record is None or (args.project and args.project not in record["project"]):
            continue
        if args.since and record["start"] < args.since:
            continue
        records.append(record)
        messages.extend(msgs)
    records.sort(key=lambda r: (r["project"], r["start"]))

    if args.messages:
        with open(args.messages, "w", encoding="utf-8") as f:
            for project, sid, t, text in sorted(messages, key=lambda m: (m[0], m[2] or datetime.datetime.min.replace(tzinfo=datetime.timezone.utc))):
                f.write(f"=== {project} {sid} {t.strftime('%Y-%m-%d %H:%M') if t else ''}\n{text[:1500]}\n")

    if args.json:
        json.dump([{k: v for k, v in r.items() if k != "_exact"} for r in records],
                  sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 0

    totals = collections.OrderedDict()
    for r in records:
        t = totals.setdefault(r["project"], collections.Counter())
        t["sessions"] += 1
        for key in ("nuser", "nsubs"):
            t[key] += r[key]
        for key, value in r["_exact"].items():
            t[key] += value
    columns = ("sessions", "wall_h", "active_h", "nuser", "out_k", "nsubs", "sub_h")
    print("\t".join(("project",) + columns))
    for project, t in totals.items():
        cells = [str(int(t[c])) if c == "out_k" else str(round(t[c], 1)) for c in columns]
        print("\t".join([project] + cells))
    return 0


if __name__ == "__main__":
    try:
        code = main()
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 0
    sys.exit(code)
