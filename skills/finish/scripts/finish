#!/usr/bin/env bash
# The git half of finishing a unit. Narrow on purpose: the skill makes the
# judgement calls — is it done, what do the messages say, what did the human
# choose — and this script performs them, refusing to act on any state it does
# not recognise.
#
# Usage:
#   finish preflight [--base SHA]
#   finish ref
#   finish squash [--base SHA] MESSAGE_FILE [--through SHA MESSAGE_FILE]...
#   finish merge [--base SHA] [--subject LINE]
#   finish recover [ATTEMPT]
set -euo pipefail

# Recovery refs are numbered per branch and never overwritten:
#
#   refs/dev-skills/recovery/<branch>/<attempt>
#
# A single ref could not survive a second squash — the second one would point it
# at the first squashed commit, and the pre-squash state the ref existed to
# reach would become unreachable at exactly the moment somebody wanted it.
RECOVERY_ROOT=refs/dev-skills/recovery
LANDED_ROOT=refs/dev-skills/landed
SQUASH_ROOT=refs/dev-skills/squash

# git-guard's subject rule, copied: the hook reads the command string and cannot
# see a message passed with -F, so the unit's landing commits are checked here,
# before anything moves.
CONVENTIONAL='^(([A-Z][A-Z0-9]*-[0-9]+|#[0-9]+):?[[:space:]]+)?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'
BANNED_TRAILERS='^[[:space:]]*(Co-Authored-By|Claude-Session)[[:space:]]*:|Generated with Claude Code|🤖'

git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "not a git repository" >&2; exit 2; }

die() { echo "finish: $*" >&2; exit 1; }

default_branch() {
  local d
  d="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  if [ -z "$d" ]; then
    if   git show-ref --verify --quiet refs/heads/main;   then d=main
    elif git show-ref --verify --quiet refs/heads/master; then d=master
    fi
  fi
  printf '%s' "$d"
}

current_branch() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

recovery_prefix() {
  printf '%s/%s' "$RECOVERY_ROOT" "$(current_branch)"
}

# The attempts recorded for this branch, in numeric order, as "<n>\t<sha>".
recovery_attempts() {
  local prefix
  prefix="$(recovery_prefix)"
  git for-each-ref --format='%(refname) %(objectname)' "$prefix/*" 2>/dev/null \
    | while read -r ref sha; do
        local n="${ref##*/}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        printf '%s\t%s\n' "$n" "$sha"
      done | LC_ALL=C sort -n -k1,1
}

# Record HEAD as the next attempt. The empty <oldvalue> makes git refuse if the
# ref already exists, so "never overwritten" is enforced by git rather than by
# this script having computed the number correctly.
record_recovery() {
  local prefix max n ref
  prefix="$(recovery_prefix)"
  max="$(recovery_attempts | tail -1 | cut -f1)"
  n=$(( ${max:-0} + 1 ))
  ref="$prefix/$n"
  git update-ref "$ref" HEAD "" \
    || die "recovery ref $ref already exists — refusing to overwrite it; inspect it with 'finish recover' and clear it deliberately"
  echo "recovery ref: $ref -> $(git rev-parse --short HEAD)"
}

assert_settled() {
  local where="$1" dir
  dir="$(git -C "$where" rev-parse --git-dir)"
  case "$dir" in /*) ;; *) dir="$where/$dir" ;; esac
  if [ -f "$dir/MERGE_HEAD" ]; then die "merge in progress in $where — settle it first"; fi
  if [ -d "$dir/rebase-merge" ] || [ -d "$dir/rebase-apply" ]; then
    die "rebase in progress in $where — settle it first"
  fi
  if [ -f "$dir/CHERRY_PICK_HEAD" ] || [ -f "$dir/REVERT_HEAD" ] || [ -d "$dir/sequencer" ]; then
    die "cherry-pick or revert in progress in $where — settle it first"
  fi
}

assert_clean() {
  local where="$1" dirty
  dirty="$(git -C "$where" status --porcelain --untracked-files=no | wc -l | tr -d ' ')"
  [ "$dirty" -eq 0 ] || die "$dirty tracked path(s) modified but not committed in $where — commit or discard them first"
}

BASE=""
DEF=""
resolve_base() {
  local explicit="$1" recorded
  DEF="$(default_branch)"
  [ -n "$DEF" ] || die "cannot resolve the default branch"
  if [ -n "$explicit" ]; then
    git rev-parse --verify --quiet "$explicit^{commit}" >/dev/null \
      || die "the base ($explicit) is not a commit in this repository"
    git merge-base --is-ancestor "$explicit" HEAD \
      || die "the base ($explicit) is not an ancestor of HEAD — the branch was rebased since; run without --base"
    BASE="$(git rev-parse "$explicit^{commit}")"
  else
    recorded="$(git config --get "branch.$(current_branch).devskillsbase" 2>/dev/null || true)"
    if [ -n "$recorded" ] && git merge-base --is-ancestor "$recorded" HEAD 2>/dev/null; then
      BASE="$recorded"
    else
      BASE="$(git merge-base HEAD "$DEF")" || die "HEAD shares no history with $DEF"
    fi
  fi
  if git merge-base --is-ancestor "$BASE" "$DEF"; then
    BASE="$(git merge-base HEAD "$DEF")"
  fi
}

carried_branches() {
  local other tip head recorded
  head="$(git rev-parse HEAD)"
  while IFS= read -r other; do
    [ -n "$other" ] && [ "$other" != "$(current_branch)" ] && [ "$other" != "$DEF" ] || continue
    tip="$(git rev-parse "refs/heads/$other")"
    [ "$tip" != "$head" ] || continue
    git merge-base --is-ancestor "$tip" "$DEF" && continue
    git merge-base --is-ancestor "$tip" "$BASE" && continue
    git merge-base --is-ancestor "$tip" HEAD || continue
    recorded="$(git config --get "branch.$other.devskillsbase" 2>/dev/null || true)"
    if [ -n "$recorded" ] && [ "$recorded" != "$BASE" ] && git merge-base --is-ancestor "$BASE" "$recorded" 2>/dev/null; then
      continue
    fi
    echo "$other"
  done < <(git for-each-ref --format='%(refname:short)' refs/heads/)
}

within() {
  [ "$1" != "$BASE" ] && git merge-base --is-ancestor "$1" "$BASE" && git merge-base --is-ancestor "$BASE" "$2"
}

refuse_carried() {
  local carried
  [ -z "$1" ] || return 0
  carried="$(carried_branches | tr '\n' ' ')"
  [ -z "$carried" ] || die "this range carries commits of ${carried% }, which has not landed — finish that first, or pass --base where this unit starts"
}

landed_by_finish() {
  local ref sha unit n tip
  while read -r ref sha; do
    case "$ref" in */base) ;; *) continue ;; esac
    unit="${ref#"$LANDED_ROOT"/}"
    unit="${unit%/base}"
    tip="$(git rev-parse --verify --quiet "$LANDED_ROOT/$unit/tip")" || continue
    within "$sha" "$tip" && return 0
    while read -r ref sha; do
      n="${ref##*/}"
      tip="$(git rev-parse --verify --quiet "$RECOVERY_ROOT/$unit/$n")" || continue
      within "$sha" "$tip" && return 0
    done < <(git for-each-ref --format='%(refname) %(objectname)' "$SQUASH_ROOT/$unit/")
  done < <(git for-each-ref --format='%(refname) %(objectname)' "$LANDED_ROOT/")
  return 1
}

landed_by_content() {
  local out rc
  out="$(git merge-tree --write-tree "$DEF" "$BASE" 2>&1)"
  rc=$?
  [ "$rc" -lt 128 ] || die "deciding whether the stacked work landed needs git 2.38 or newer (git merge-tree --write-tree)"
  [ "$rc" -eq 0 ] && [ "$(printf '%s\n' "$out" | sed -n 1p)" = "$(git rev-parse "$DEF^{tree}")" ]
}

assert_on_unit_branch() {
  local branch
  branch="$(current_branch)"
  [ -n "$branch" ] || die "detached HEAD — check out the unit's branch first"
  [ "$branch" != "$(default_branch)" ] || die "on the default branch — finish runs on the unit's branch"
}

EXPLICIT=""
parse_base_arg() {
  EXPLICIT=""
  if [ "${1:-}" = "--base" ]; then
    [ $# -ge 2 ] || die "--base needs a commit"
    EXPLICIT="$2"
  elif [ $# -gt 0 ]; then
    die "unexpected argument: $1"
  fi
}

cmd_preflight() {
  local range
  parse_base_arg "$@"
  assert_on_unit_branch
  assert_settled .
  assert_clean .
  resolve_base "$EXPLICIT"
  range="$(git rev-list --count "$BASE..HEAD")"
  [ "$range" -gt 0 ] || die "no commits between the base and HEAD — there is nothing to finish"

  echo "branch:   $(current_branch)"
  echo "base:     $(git rev-parse --short "$BASE")"
  git merge-base --is-ancestor "$BASE" "$DEF" \
    || echo "stacked:  the base is not on $DEF; merge moves this unit once what it stacks on has landed"
  if [ -z "$EXPLICIT" ]; then
    carried_branches | while IFS= read -r other; do
      echo "note: this range carries commits of $other, which has not landed; squash and merge refuse until it does, or until --base names where this unit starts"
    done
  fi
  echo "commits:"
  git log --reverse --format='  %h %s' "$BASE..HEAD" --not "$DEF"
  echo "paths:"
  git log --format= --name-only "$BASE..HEAD" --not "$DEF" | sed '/^$/d' | LC_ALL=C sort -u | sed 's/^/  /'
  echo "preflight clean"
}

cmd_ref() {
  assert_on_unit_branch
  record_recovery
}

assert_message_ok() {
  local msgfile subject body
  msgfile="$1"
  [ -f "$msgfile" ] || die "no message file at $msgfile"
  subject="$(git stripspace < "$msgfile" | sed -n 1p)"
  [ -n "$subject" ] || die "$msgfile has no subject line"

  if printf '%s' "$subject" | grep -qE '<type>|<scope>|<one line'; then
    die "the subject line in $msgfile is still the placeholder — write the real one"
  fi
  if ! printf '%s' "$subject" | grep -qE "$CONVENTIONAL"; then
    die "subject is not Conventional Commits ('$subject')
  use 'type(scope): summary'; type in feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
  fi
  if [ "$(printf '%s' "$subject" | LC_ALL=en_US.UTF-8 wc -m | tr -d ' ')" -gt 72 ]; then
    die "the subject in $msgfile is over 72 characters"
  fi
  body="$(git stripspace < "$msgfile" | sed '1d' | sed '/./,$!d')"
  if [ "$(printf '%s' "$body" | LC_ALL=en_US.UTF-8 wc -m | tr -d ' ')" -gt 300 ]; then
    die "the body in $msgfile is over 300 characters"
  fi
  if grep -qiE "$BANNED_TRAILERS" "$msgfile"; then
    die "$msgfile carries a banned trailer (Co-Authored-By / Generated with Claude Code / Claude-Session)"
  fi
}

cmd_squash() {
  local explicit="" msgs=() ends=() prev before new i end sign=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)
        [ $# -ge 2 ] || die "--base needs a commit"
        explicit="$2"; shift 2 ;;
      --through)
        [ $# -ge 2 ] || die "--through needs a commit"
        [ ${#msgs[@]} -gt 0 ] || die "--through closes the group of the message file before it"
        [ ${#ends[@]} -lt ${#msgs[@]} ] || die "one --through per message file"
        ends+=("$2"); shift 2 ;;
      *)
        [ ${#ends[@]} -eq ${#msgs[@]} ] || die "$1 follows a message file with no --through; every group but the last needs one"
        msgs+=("$1"); shift ;;
    esac
  done
  [ ${#msgs[@]} -gt 0 ] || die "usage: finish squash [--base SHA] MESSAGE_FILE [--through SHA MESSAGE_FILE]..."
  [ ${#ends[@]} -lt ${#msgs[@]} ] || die "the last message file takes the rest of the range; drop its --through"
  ends+=(HEAD)
  for i in "${!msgs[@]}"; do assert_message_ok "${msgs[$i]}"; done

  cmd_preflight ${explicit:+--base "$explicit"} >/dev/null
  resolve_base "$explicit"
  refuse_carried "$explicit"
  prev="$BASE"
  for i in "${!ends[@]}"; do
    end="$(git rev-parse --verify --quiet "${ends[$i]}^{commit}")" || die "--through ${ends[$i]} is not a commit"
    if [ "$end" = "$prev" ] || ! git merge-base --is-ancestor "$prev" "$end" \
       || ! git merge-base --is-ancestor "$end" HEAD; then
      die "--through ${ends[$i]} is not a later commit of this range, in order"
    fi
    ends[$i]="$end"
    prev="$end"
  done

  if [ "$(git config --bool commit.gpgsign 2>/dev/null || true)" = "true" ]; then sign="-S"; fi
  before="$(git rev-parse 'HEAD^{tree}')"
  record_recovery
  git update-ref "$SQUASH_ROOT/$(current_branch)/$(recovery_attempts | tail -1 | cut -f1)" "$BASE"
  new="$BASE"
  for i in "${!msgs[@]}"; do
    new="$(git stripspace < "${msgs[$i]}" \
      | git commit-tree ${sign:+"$sign"} "${ends[$i]}^{tree}" -p "$new")"
  done
  git reset --soft "$new"
  [ "$(git rev-parse 'HEAD^{tree}')" = "$before" ] \
    || die "tree changed across the squash — recover with 'finish recover <attempt>' and investigate"

  echo "squashed into ${#msgs[@]} commit(s) on $(git rev-parse --short "$BASE"):"
  git log --reverse --format='  %h %s' "$BASE..HEAD"
}

cmd_merge() {
  local branch target out conflicts switched="" wt moved="" base_before subject=""
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --subject) [ $# -ge 2 ] || die "--subject needs a line"; subject="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  parse_base_arg ${args[@]+"${args[@]}"}
  assert_on_unit_branch
  assert_settled .
  assert_clean .
  branch="$(current_branch)"
  resolve_base "$EXPLICIT"
  [ "$(git rev-list --count "$BASE..HEAD")" -gt 0 ] || die "no commits between the base and HEAD — there is nothing to merge"
  refuse_carried "$EXPLICIT"
  [ -n "$subject" ] || subject="$(git log -1 --format=%s HEAD)"
  printf '%s' "$subject" | grep -qE "$CONVENTIONAL" \
    || die "the merge subject is not a Conventional Commit: '$subject' — pass --subject"

  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    for f in "$wt/rebase-merge/head-name" "$wt/rebase-apply/head-name"; do
      if [ -f "$f" ] && [ "$(cat "$f")" = "refs/heads/$DEF" ]; then
        die "$DEF is being rebased in another checkout — settle that first"
      fi
    done
  done < <(printf '%s\n' "$(git rev-parse --git-common-dir)"; ls -d "$(git rev-parse --git-common-dir)"/worktrees/* 2>/dev/null)

  target="$(git worktree list --porcelain \
    | awk -v want="branch refs/heads/$DEF" '/^worktree /{w=substr($0,10)} $0==want{print w; exit}')"
  if [ -n "$target" ]; then
    [ -d "$target" ] || die "$DEF is checked out at $target, which no longer exists — run 'git worktree prune'"
    assert_settled "$target"
    assert_clean "$target"
  fi

  base_before="$BASE"
  if ! git merge-base --is-ancestor "$BASE" "$DEF"; then
    landed_by_finish || landed_by_content \
      || die "this branch is stacked on $(git rev-parse --short "$BASE"), and the work below it has not landed on $DEF — finish that first"
    record_recovery
    if ! out="$(git rebase --onto "$DEF" "$BASE" 2>&1)"; then
      conflicts="$(git diff --name-only --diff-filter=U)"
      git rebase --abort >/dev/null 2>&1 || true
      die "moving this unit onto $DEF conflicts; the branch is as it was (a recovery ref was recorded). Conflicting paths:
${conflicts:-$out}"
    fi
    moved=1
    echo "moved onto $DEF: what it stacked on has landed"
  fi

  if [ -z "$target" ]; then
    git checkout -q "$DEF" || { git checkout -q "$branch" 2>/dev/null || true; die "cannot check out $DEF here"; }
    target="."
    switched=1
  fi

  if ! out="$(git -C "$target" merge --no-ff -m "$subject" "$branch" 2>&1)"; then
    conflicts="$(git -C "$target" diff --name-only --diff-filter=U)"
    git -C "$target" merge --abort >/dev/null 2>&1 || true
    if [ -n "$switched" ]; then git checkout -q "$branch" || true; fi
    die "the merge into $DEF failed and was aborted; $DEF is as it was${moved:+, and this branch now sits on $DEF (its recovery ref holds the old place)}. If it conflicts, rebase this branch onto $DEF, resolve there, and finish again.
${conflicts:-$out}"
  fi
  if [ -n "$switched" ]; then
    git checkout -q "$branch" || echo "note: $DEF is merged, but switching back to $branch failed" >&2
  fi
  git update-ref "$LANDED_ROOT/$branch/base" "$base_before"
  git update-ref "$LANDED_ROOT/$branch/tip" "$(git rev-parse "refs/heads/$branch")"

  echo "merged $branch into $DEF (--no-ff) at $(git -C "$target" rev-parse --short "$DEF")"
  git -C "$target" log --reverse --format='  %h %s' "$DEF^1..$DEF^2"
}

# An attempt is required. There is no default, and "the latest" is not one
# either: a unit that squashed twice has two states worth reaching, and guessing
# which one wanted resetting is how a recovery destroys the thing it was called
# to save. With no argument this prints what exists and changes nothing.
cmd_recover() {
  local want attempts ref prefix
  want="${1:-}"
  prefix="$(recovery_prefix)"
  attempts="$(recovery_attempts)"
  [ -n "$attempts" ] || die "no recovery ref under $prefix/ — nothing to recover"

  if [ -z "$want" ]; then
    echo "recovery attempts on this branch, newest last:"
    printf '%s\n' "$attempts" | while IFS=$'\t' read -r n sha; do
      printf '  %s  %s  %s\n' "$n" "$(git rev-parse --short "$sha")" \
        "$(git log -1 --format=%s "$sha")"
    done
    echo "name one: finish recover <attempt>"
    exit 2
  fi

  case "$want" in ''|*[!0-9]*) die "attempt must be a number; got '$want'" ;; esac
  ref="$prefix/$want"
  git rev-parse --verify --quiet "$ref" >/dev/null \
    || die "no attempt $want on this branch — run 'finish recover' with no argument to see what there is"

  echo "resetting to $(git rev-parse --short "$ref") (attempt $want)"
  git reset --hard "$ref"
  echo "recovered; every recovery ref is left in place"
}

case "${1:-}" in
  preflight) shift; cmd_preflight "$@" ;;
  ref)       shift; cmd_ref "$@" ;;
  squash)    shift; cmd_squash "$@" ;;
  merge)     shift; cmd_merge "$@" ;;
  recover)   shift; cmd_recover "$@" ;;
  *)
    echo "usage: finish {preflight [--base SHA]|ref|squash [--base SHA] MESSAGE_FILE [--through SHA MESSAGE_FILE]...|merge [--base SHA] [--subject LINE]|recover [ATTEMPT]}" >&2
    exit 2
    ;;
esac
