#!/usr/bin/env bash
# The git half of finishing a run. Narrow on purpose: the skill makes the
# judgement calls — is it done, what does the message say, what did the human
# choose — and this script performs them, refusing to act on any state it does
# not recognise.
#
# Why reset --soft rather than an interactive rebase: it touches neither the
# index nor the working tree, so a conflict is impossible by construction, and
# the equivalence of the trees is *guaranteed* rather than checked — the script
# only has to confirm the hashes match. On any refusal the state is left staged:
# nothing is lost and everything is visible.
#
# Usage:
#   finish preflight
#   finish squash MESSAGE_FILE
#   finish rebase
#   finish integrate --ff-only
#   finish cleanup
#   finish recover [ATTEMPT]
set -euo pipefail

# Recovery refs are numbered per branch and never overwritten:
#
#   refs/dev-skills/recovery/<branch>/<attempt>
#
# A single ref could not survive a second squash — the second one would point it
# at the first squashed commit, and the pre-squash state the ref existed to
# reach would become unreachable at exactly the moment somebody wanted it.
RECOVERY_ROOT=refs/dev-skills/recovery

# commit-guard's own subject rule, copied deliberately.
#
# The hook reads the *command string*, so it validates `git commit -m "…"` and
# cannot see a message passed with -F. `finish squash` uses -F, which makes the
# run's one landing commit the only one in the whole run that reaches git
# unchecked — both for the subject and for the banned trailers. Checking here is
# what closes that, and it happens before `reset --soft` so a refusal costs
# nothing and leaves the branch untouched.
#
# If commit-guard's rule changes, change this one with it; they are two copies of
# one decision and there is no way to share them across a hook and a script.
CONVENTIONAL='^(([A-Z][A-Z0-9]*-[0-9]+|#[0-9]+):?[[:space:]]+)?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'
BANNED_TRAILERS='Co-Authored-By|Generated with Claude Code|Claude-Session:|🤖'

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repository" >&2; exit 2; }
gitdir="$(git rev-parse --git-dir)"
common="$(git rev-parse --git-common-dir)"
runs="$root/.ai-workflow/run"

die() { echo "finish: $*" >&2; exit 1; }

# The marker lives with its run's artifacts, at .ai-workflow/run/<plan>/RUN.
# Exactly one is expected: run-state refuses to open a second.
#
# resolve_marker is called as a plain statement, never inside $(...), so that its
# die() ends the script rather than a subshell — a refusal has to stop the run,
# not be swallowed and turned into an empty string downstream.
MARKER=""
resolve_marker() {
  [ -n "$MARKER" ] && return 0
  local found count
  found="$([ -d "$runs" ] && find "$runs" -mindepth 2 -maxdepth 2 -name RUN -type f 2>/dev/null | LC_ALL=C sort || true)"
  [ -n "$found" ] || die "no run marker under .ai-workflow/run/*/ — this run was never opened by dev-skills:implement, or it is already finished"
  count="$(printf '%s\n' "$found" | wc -l | tr -d ' ')"
  if [ "$count" -gt 1 ]; then
    echo "finish: more than one run marker — finish or clear these before continuing:" >&2
    printf '%s\n' "$found" | sed 's/^/  /' >&2
    exit 1
  fi
  MARKER="$found"
}

marker_field() {
  sed -n "s/^$1=//p" "$MARKER" | head -1
}

default_branch() {
  local d
  d="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  if [ -z "$d" ]; then
    if   git show-ref --verify --quiet refs/heads/main;   then d=main
    elif git show-ref --verify --quiet refs/heads/master; then d=master
    fi
  fi
  printf '%s' "$d"
}

recovery_prefix() {
  printf '%s/%s' "$RECOVERY_ROOT" "$(git rev-parse --abbrev-ref HEAD)"
}

# The attempts recorded for this branch, in numeric order, as "<n>\t<sha>".
recovery_attempts() {
  local prefix
  prefix="$(recovery_prefix)"
  git for-each-ref --format='%(refname) %(objectname)' "$prefix/*" 2>/dev/null \
    | while read -r ref sha; do
        local n="${ref##*/}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        printf '%s\t%s\n' "$n" "$sha"
      done | LC_ALL=C sort -n -k1,1
}

# Record HEAD as the next attempt. The empty <oldvalue> makes git refuse if the
# ref already exists, so "never overwritten" is enforced by git rather than by
# this script having computed the number correctly.
record_recovery() {
  local prefix max n ref
  prefix="$(recovery_prefix)"
  max="$(recovery_attempts | tail -1 | cut -f1)"
  n=$(( ${max:-0} + 1 ))
  ref="$prefix/$n"
  git update-ref "$ref" HEAD "" \
    || die "recovery ref $ref already exists — refusing to overwrite it; inspect it with 'finish recover' and clear it deliberately"
  echo "recovery ref: $ref -> $(git rev-parse --short HEAD)"
}

assert_settled() {
  if [ -f "$gitdir/MERGE_HEAD" ]; then die "merge in progress — settle it first"; fi
  if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
    die "rebase in progress — settle it first"
  fi
  if [ -f "$gitdir/CHERRY_PICK_HEAD" ]; then die "cherry-pick in progress — settle it first"; fi
  if [ -f "$gitdir/REVERT_HEAD" ]; then die "revert in progress — settle it first"; fi
}

cmd_preflight() {
  local base branch plan head range dirty untracked
  resolve_marker
  plan="$(marker_field plan)"
  base="$(marker_field base)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  head="$(git rev-parse HEAD)"

  assert_settled
  git rev-parse --verify --quiet "$base" >/dev/null || die "the run's base ($base) is not a commit in this repository"
  git merge-base --is-ancestor "$base" HEAD 2>/dev/null || die "the run's base is not an ancestor of HEAD — the history was rewritten under the run"

  if [ "$branch" = "HEAD" ]; then die "detached HEAD — check out the run's branch first"; fi
  if [ "$branch" = "$(default_branch)" ]; then
    die "on the default branch — a run is not finished onto the branch it targets"
  fi

  range="$(git rev-list --count "$base..HEAD")"
  [ "$range" -gt 0 ] || die "no commits between the base and HEAD — there is nothing to finish"

  dirty="$(git status --porcelain --untracked-files=no | wc -l | tr -d ' ')"
  untracked="$(git ls-files --others --exclude-standard | wc -l | tr -d ' ')"
  [ "$dirty" -eq 0 ] || die "$dirty tracked path(s) modified but not committed — commit or discard them first"

  echo "plan:     $plan"
  echo "branch:   $branch"
  echo "base:     $(git rev-parse --short "$base")"
  echo "head:     $(git rev-parse --short "$head")"
  echo "commits:  $range"
  echo "tree:     $root"
  if [ "$untracked" -gt 0 ]; then
    echo "note:     $untracked untracked file(s) — they take no part in the squash"
  fi
  echo "paths touched by the run:"
  git diff --name-only "$base..HEAD" | sed 's/^/  /'
  echo "preflight clean"
}

# Enforced before anything is moved, so a bad subject costs a refusal rather than
# a reset --soft the caller then has to unpick.
assert_message_ok() {
  local msgfile subject
  msgfile="$1"
  subject="$(grep -vE '^[[:space:]]*#' "$msgfile" | grep -vE '^[[:space:]]*$' | head -1)"
  [ -n "$subject" ] || die "$msgfile has no subject line"

  if printf '%s' "$subject" | grep -qE '<type>|<scope>|<one line'; then
    die "the subject line in $msgfile is still the placeholder — write the real one"
  fi
  if ! printf '%s' "$subject" | grep -qE "$CONVENTIONAL"; then
    die "subject is not Conventional Commits ('$subject')
  use 'type(scope): summary'; type in feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert
  commit-guard cannot see a -F message, so this is the only place it is checked"
  fi
  if grep -qiE "$BANNED_TRAILERS" "$msgfile"; then
    die "$msgfile carries a banned trailer (Co-Authored-By / Generated with Claude Code / Claude-Session)
  remove it; commit-guard cannot see a -F message and would not have caught this"
  fi
}

cmd_squash() {
  local msgfile base before after pre_squash
  msgfile="${1:-}"
  [ -n "$msgfile" ] && [ -f "$msgfile" ] || die "usage: finish squash MESSAGE_FILE"
  assert_message_ok "$msgfile"

  cmd_preflight >/dev/null
  resolve_marker
  base="$(marker_field base)"
  before="$(git rev-parse 'HEAD^{tree}')"
  pre_squash="$(git rev-parse HEAD)"

  record_recovery

  git reset --soft "$base"
  git commit --cleanup=strip -F "$msgfile" --quiet

  after="$(git rev-parse 'HEAD^{tree}')"
  if [ "$before" != "$after" ]; then
    die "tree hash changed across the squash ($before -> $after) — this cannot normally happen; recover with 'finish recover <attempt>' and investigate"
  fi

  echo "squashed $(git rev-parse --short "$base")..$(git rev-parse --short "$pre_squash") into $(git rev-parse --short HEAD)"
  echo "trees identical: $before"
}

cmd_rebase() {
  local base def old_base new_base overlap
  resolve_marker
  base="$(marker_field base)"
  def="$(default_branch)"
  [ -n "$def" ] || die "cannot resolve the default branch"
  assert_settled

  old_base="$base"
  new_base="$(git rev-parse --verify "$def")"
  if [ "$old_base" = "$new_base" ]; then echo "base has not moved — no rebase needed"; return 0; fi

  echo "base moved: $(git rev-parse --short "$old_base") -> $(git rev-parse --short "$new_base")"
  overlap="$(comm -12 \
    <(git diff --name-only "$old_base..$new_base" | sort) \
    <(git diff --name-only "$old_base..HEAD" | sort))"

  if [ -n "$overlap" ]; then
    echo "the base touched paths this run also touched:"
    printf '%s\n' "$overlap" | sed 's/^/  /'
    echo "→ gate B re-runs the affected cases, then acceptance covers only those"
  else
    echo "no path overlap → the acceptance stands"
  fi

  # Recorded before the rebase, not after: what a recovery wants back is the
  # state the rebase is about to rewrite.
  record_recovery

  if git rebase "$new_base"; then
    sed -i.bak "s|^base=.*|base=$new_base|" "$MARKER" && rm -f "$MARKER.bak"
    echo "rebased; run base updated to $(git rev-parse --short "$new_base")"
  else
    echo "rebase stopped with conflicts — resolving a conflict is a code change:" >&2
    echo "  settle the rebase, then run an ordinary remediation segment" >&2
    exit 1
  fi
}

cmd_integrate() {
  [ "${1:-}" = "--ff-only" ] || die "usage: finish integrate --ff-only (no other mode is offered)"
  local def branch main_root was out
  def="$(default_branch)"
  [ -n "$def" ] || die "cannot resolve the default branch"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  assert_settled

  main_root="$(cd "$common/.." && pwd -P)"
  git -C "$main_root" rev-parse --verify --quiet "$def" >/dev/null || die "no local $def to integrate into"

  # Whether a fast-forward is possible is decided here, from the graph alone,
  # before anything in the main checkout is touched. Deciding it from the exit
  # code of the checkout or the merge is what produced "not a fast-forward — the
  # base has moved" for a failure that was nothing of the kind: an untracked
  # file in the main checkout standing where a tracked one was about to land.
  # That message sends the human to `finish rebase`, which cannot help, and it
  # hides the one thing they need to know — which file is in the way.
  if ! git merge-base --is-ancestor "$def" "$branch"; then
    die "not a fast-forward — $def has moved; rebase first (finish rebase)"
  fi

  was="$(git -C "$main_root" rev-parse --abbrev-ref HEAD)"
  if ! out="$(git -C "$main_root" checkout "$def" 2>&1)"; then
    die "cannot check out $def in the main checkout ($main_root).
$def is an ancestor of $branch, so the history is fine — git is refusing for
another reason, and it is below verbatim. An untracked file in the way is the
usual one; commit or remove it there and run this again.

$out"
  fi

  if out="$(git -C "$main_root" merge --ff-only "$branch" 2>&1)"; then
    echo "integrated $branch into $def (fast-forward)"
  else
    git -C "$main_root" checkout --quiet "$was" 2>/dev/null || true
    die "the merge into $def failed even though it is a fast-forward by the
graph. git's own reason, verbatim:

$out"
  fi
}

cmd_cleanup() {
  local wt
  if [ "$gitdir" = "$common" ]; then echo "not a worktree — nothing to clean up"; return 0; fi
  wt="$root"
  case "$wt" in
    */.worktrees/*|*/worktrees/*) ;;
    *) echo "worktree at $wt was not created by this workflow — leaving it in place"; return 0 ;;
  esac
  cd "$(cd "$common/.." && pwd -P)"
  git worktree remove "$wt"
  git worktree prune
  echo "removed worktree $wt"
}

# An attempt is required. There is no default, and "the latest" is not one
# either: a run that squashed twice has two states worth reaching, and guessing
# which one wanted resetting is how a recovery destroys the thing it was called
# to save. With no argument this prints what exists and changes nothing.
cmd_recover() {
  local want attempts ref prefix
  want="${1:-}"
  prefix="$(recovery_prefix)"
  attempts="$(recovery_attempts)"
  [ -n "$attempts" ] || die "no recovery ref under $prefix/ — nothing to recover"

  if [ -z "$want" ]; then
    echo "recovery attempts on this branch, newest last:"
    printf '%s\n' "$attempts" | while IFS=$'\t' read -r n sha; do
      printf '  %s  %s  %s\n' "$n" "$(git rev-parse --short "$sha")" \
        "$(git log -1 --format=%s "$sha")"
    done
    echo "name one: finish recover <attempt>"
    exit 2
  fi

  case "$want" in ''|*[!0-9]*) die "attempt must be a number; got '$want'" ;; esac
  ref="$prefix/$want"
  git rev-parse --verify --quiet "$ref" >/dev/null \
    || die "no attempt $want on this branch — run 'finish recover' with no argument to see what there is"

  echo "resetting to $(git rev-parse --short "$ref") (attempt $want)"
  git reset --hard "$ref"
  echo "recovered; every recovery ref is left in place"
}

case "${1:-}" in
  preflight) shift; cmd_preflight "$@" ;;
  squash)    shift; cmd_squash "$@" ;;
  rebase)    shift; cmd_rebase "$@" ;;
  integrate) shift; cmd_integrate "$@" ;;
  cleanup)   shift; cmd_cleanup "$@" ;;
  recover)   shift; cmd_recover "$@" ;;
  *)
    echo "usage: finish {preflight|squash MESSAGE_FILE|rebase|integrate --ff-only|cleanup|recover [ATTEMPT]}" >&2
    exit 2
    ;;
esac
