#!/usr/bin/env bash
# Refuses a malformed plan before a human ever dispatches work against it.
#
# Eleven mechanical checks, fence-aware the way brief and preflight
# already are (a heading inside a fenced example is not a heading):
#   1. '## Phases' is present
#   2. at least one '### Phase <n>.' heading exists
#   3. phase numbers are contiguous starting at 1
#   4. every '### Phase <n>.' carries all nine field headings — reported
#      per phase, naming the phase and every field it lacks
#   5. '## Topology' has a first table whose header is exactly
#      '| Phases | Why the boundary is here |', and every phase number
#      appears in exactly one row's range, written as '<a>-<b>' or '<n>'
#   6. '## Ledger' is present once '## Topology' is
#   7. '## Moments', when present and not a bare '—', holds only moment
#      headings ('- **M-<n>. <text>** · US-<n>[, ...]') each carrying at
#      least one 'US-' reference and at least two numbered steps
#   8. every phase's '**Depends on**' is well-formed — either a lone '- —'
#      or one or more '- phase <n> — <why this phase needs its file>'
#      bullets, each naming an earlier phase, never both
#   9. every phase's '**Verification**' names the join that proves it — an
#      ordinary phase carries one '- proved by: phase <n>', a join carries
#      '- joins: phases <a>-<b>' and '- cases: TC-<n>[, TC-<n>...]' or
#      '- cases: —', never both bullets in one field; and the join a phase
#      names exists, is later, carries a '- joins:' bullet of its own and
#      covers that phase
#  10. the '## Topology' rows are the partition the joins induce — every
#      phase between two joins in one row, every join alone in its own —
#      so a barrier that is not a join is refused (ADR-0005)
#  11. every phase's '**Implementer**' names exactly one of Sonnet or
#      Opus, alone or followed by ' — <why>'
#
# Check 9 needs no cycle detector and none is wanted: '- proved by:' always
# names a higher-numbered phase, '- joins:' always a lower-numbered range,
# and phase numbers are contiguous from 1 (check 3), so every reference
# resolves and the relation is acyclic by construction.
#
# Check 1 is the one fault with no decision in it: the heading always goes
# immediately above the first '### Phase 1.', so it is inserted in place and
# announced with one 'fixed:' line — never counted as a finding. Every other
# check only reports: which phase a missing field belongs to is knowable,
# what belongs in it is not, and this script cannot guess it. Idempotent —
# a second run on an already-repaired plan changes nothing and prints no
# 'fixed:' line.
#
# Checks 5 and 6 read '## Topology' / '## Ledger' as a pair of trailing
# sections written together at the end of a plan: neither is flagged simply
# for being entirely absent (a plan mid-draft, still only phases, is not yet
# wrong for that), but once '## Topology' exists its table must be shaped
# right and cover every phase exactly once, and '## Ledger' must exist
# alongside it.
#
# Every reported finding names its fix — the phase, the field, the line —
# and ends by telling the reader not to open this script to find out why:
# that sentence is the point of the whole thing, replacing the 106-line read
# and the plan re-read this used to cost an orchestrator.
#
# Usage: plan-check PLAN_FILE
# Exit:  0 clean, or repaired with nothing left to decide
#        1 findings printed on stdout
#        2 usage or no such file
set -uo pipefail

PROG="plan-check"
DONT_READ="Do not read this script to find out why."

if [ $# -ne 1 ]; then
  echo "usage: $PROG PLAN_FILE" >&2
  exit 2
fi

plan="$1"
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

fixed=()
findings=()

# nums_not_in HAYSTACK NEEDLES — the numbers present in HAYSTACK and absent
# from NEEDLES, one per line, order preserved. Both arguments are newline-
# separated lists of integers.
#
# Deliberately not `comm`. Every list here is sorted with `sort -n`, and comm
# compares its inputs as strings whatever the locale: numerically 9 precedes
# 10, lexicographically it does not. Fed numerically-sorted input, comm walks
# off at the first two-digit number and silently reports phases as missing or
# duplicated that are neither. A plan of nine phases never shows it; a plan of
# ten does.
# The needles travel through the environment, not through `awk -v`: -v refuses
# a value containing a newline, and every list here is newline-separated.
nums_not_in() {
  printf '%s\n' "$1" | NUMS_HAVE="$2" awk '
    BEGIN {
      n = split(ENVIRON["NUMS_HAVE"], a, "\n")
      for (i = 1; i <= n; i++) if (a[i] != "") seen[a[i] + 0] = 1
    }
    $0 != "" && !(($0 + 0) in seen) { print }
  '
}

# first_line_matching PLAN ERE — the line number of the first non-fenced
# line matching ERE, or empty if none.
first_line_matching() {
  awk -v pat="$2" '
    /^```/ { fence = !fence; next }
    fence { next }
    $0 ~ pat { print NR; exit }
  ' "$1"
}

# --- check 1: '## Phases', repaired in place --------------------------------

phases_line=$(first_line_matching "$plan" '^##[ \t]+Phases[ \t]*$')
if [ -z "$phases_line" ]; then
  phase1_line=$(first_line_matching "$plan" '^###[ \t]+Phase[ \t]+1[.[:space:]]')
  if [ -n "$phase1_line" ]; then
    tmp=$(mktemp)
    plan_mode=$(stat -f '%Lp' "$plan" 2>/dev/null || stat -c '%a' "$plan")
    awk -v n="$phase1_line" 'NR==n { print "## Phases"; print "" } { print }' "$plan" > "$tmp"
    chmod "$plan_mode" "$tmp"
    mv "$tmp" "$plan"
    fixed+=("fixed: inserted '## Phases' above '### Phase 1.' (was line ${phase1_line}) in ${plan}")
  else
    findings+=("'## Phases' is missing from ${plan}, and there is no '### Phase 1.' heading to anchor an automatic repair — add '## Phases' above the first phase heading yourself. ${DONT_READ}")
  fi
fi

# --- check 2 & 3: phase headings exist and are contiguous from 1 -----------

raw_nums=$(awk '
  /^```/ { fence = !fence; next }
  fence { next }
  /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    print n + 0
  }
' "$plan")

if [ -z "$raw_nums" ]; then
  findings+=("no '### Phase N.' heading found in ${plan} — every plan needs at least one. ${DONT_READ}")
else
  uniq_nums=$(printf '%s\n' "$raw_nums" | LC_ALL=C sort -n -u)

  dup_nums=$(printf '%s\n' "$raw_nums" | LC_ALL=C sort -n | uniq -d)

  max=$(printf '%s\n' "$uniq_nums" | tail -1)
  expected=$(seq 1 "$max")
  missing_nums=$(nums_not_in "$expected" "$uniq_nums")

  if [ "$uniq_nums" != "$expected" ] || [ -n "$dup_nums" ]; then
    found_display=$(printf '%s' "$uniq_nums" | tr '\n' ' ' | sed -e 's/[ \t]*$//')
    msg="phase numbers in ${plan} are not contiguous from 1 — found: ${found_display}"
    if [ -n "$missing_nums" ]; then
      missing_display=$(printf '%s' "$missing_nums" | tr '\n' ' ' | sed -e 's/[ \t]*$//')
      msg="${msg}; missing: ${missing_display}"
    fi
    if [ -n "$dup_nums" ]; then
      dup_display=$(printf '%s' "$dup_nums" | tr '\n' ' ' | sed -e 's/[ \t]*$//')
      msg="${msg}; duplicated: ${dup_display}"
    fi
    findings+=("${msg}. ${DONT_READ}")
  fi
fi

# --- check 4: every phase carries all eight fields, reported per phase -----

field_issues=$(awk '
  /^```/ { fence = !fence; next }
  fence { next }

  function report(   i, out) {
    out = ""
    for (i = 1; i <= 9; i++) {
      if (!(fields[i] in has)) out = out (out == "" ? "" : "|") fields[i]
    }
    if (out != "") print phase "\t" phase_line "\t" out
  }

  BEGIN {
    split("Becomes true|Changes|Depends on|Implementer|How|Do not touch|Frozen for later phases|Verification|Steps", fields, "|")
  }

  /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    if (inphase) report()
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    phase = n + 0
    phase_line = NR
    inphase = 1
    delete has
    next
  }

  /^##[ \t]+/ && $0 !~ /^###/ {
    if (inphase) { report(); inphase = 0 }
    next
  }

  inphase && /^\*\*[A-Za-z][^*]*\*\*[ \t]*$/ {
    line = $0
    sub(/^\*\*/, "", line); sub(/\*\*[ \t]*$/, "", line)
    has[line] = 1
  }

  END { if (inphase) report() }
' "$plan")

if [ -n "$field_issues" ]; then
  while IFS=$'\t' read -r fp_phase fp_line fp_fields; do
    [ -n "$fp_phase" ] || continue
    fields_str=""
    IFS='|' read -r -a farr <<< "$fp_fields"
    for f in "${farr[@]}"; do
      fields_str="${fields_str}${fields_str:+, }**${f}**"
    done
    findings+=("phase ${fp_phase} is missing ${fields_str} — add the missing field(s) under '### Phase ${fp_phase}.' (heading at line ${fp_line}) in ${plan}. ${DONT_READ}")
  done <<< "$field_issues"
fi

# --- check 5: '## Topology', its header, and phase coverage ----------------
#
# Not flagged for being entirely absent — see the header comment. Once the
# heading exists, its first table (fence-aware, stopping at the section's
# next '##') must carry the exact header and cover every phase from checks
# 2/3 in exactly one row.

topology_line=$(first_line_matching "$plan" '^##[ \t]+Topology[ \t]*$')
if [ -n "$topology_line" ]; then
  topology_table=$(awk -v start="$topology_line" '
    /^```/ { fence = !fence; next }
    fence { next }
    NR == start { intopo = 1; next }
    intopo && /^##[ \t]+/ { exit }
    intopo && /^\|/ { print; started = 1; next }
    intopo && started { exit }
  ' "$plan")

  if [ -z "$topology_table" ]; then
    findings+=("'## Topology' in ${plan} has no table under it — add '| Phases | Why the boundary is here |' and one row per phase. ${DONT_READ}")
  else
    header_row=$(printf '%s\n' "$topology_table" | sed -n '1p')
    norm_header=$(printf '%s' "$header_row" | awk -F'|' '{
      out = ""
      for (i = 1; i <= NF; i++) {
        cell = $i; gsub(/^[ \t]+|[ \t]+$/, "", cell)
        if (cell == "" && (i == 1 || i == NF)) continue
        out = out (out == "" ? "" : " | ") cell
      }
      print out
    }')
    expected_header="Phases | Why the boundary is here"

    if [ "$norm_header" != "$expected_header" ]; then
      findings+=("the '## Topology' table header in ${plan} is '${header_row}', expected '| ${expected_header} |'. ${DONT_READ}")
    else
      body_rows=$(printf '%s\n' "$topology_table" | tail -n +2 | awk -F'|' '
        {
          sep = 1
          for (i = 1; i <= NF; i++) {
            cell = $i; gsub(/^[ \t]+|[ \t]+$/, "", cell)
            if (cell != "" && cell !~ /^:?-+:?$/) sep = 0
          }
          if (!sep) print
        }
      ')

      table_nums_raw=""
      if [ -n "$body_rows" ]; then
        while IFS= read -r row; do
          [ -n "$row" ] || continue
          cell=$(printf '%s\n' "$row" | awk -F'|' '{ c = $2; gsub(/^[ \t]+|[ \t]+$/, "", c); print c }')
          if [[ "$cell" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[2]}
          elif [[ "$cell" =~ ^[0-9]+$ ]]; then
            lo=$cell; hi=$cell
          else
            continue
          fi
          for ((p = lo; p <= hi; p++)); do
            table_nums_raw="${table_nums_raw}${table_nums_raw:+$'\n'}${p}"
          done
        done <<< "$body_rows"
      fi

      if [ -n "${uniq_nums:-}" ]; then
        if [ -n "$table_nums_raw" ]; then
          table_nums_uniq=$(printf '%s\n' "$table_nums_raw" | LC_ALL=C sort -n -u)
          cov_dup=$(printf '%s\n' "$table_nums_raw" | LC_ALL=C sort -n | uniq -d)
        else
          table_nums_uniq=""
          cov_dup=""
        fi

        cov_missing=$(nums_not_in "$uniq_nums" "$table_nums_uniq")

        if [ -n "$cov_missing" ] || [ -n "$cov_dup" ]; then
          msg="the '## Topology' table in ${plan} does not cover every phase exactly once"
          if [ -n "$cov_missing" ]; then
            miss_display=$(printf '%s' "$cov_missing" | tr '\n' ' ' | sed -e 's/[ \t]*$//')
            msg="${msg} — missing: ${miss_display}"
          fi
          if [ -n "$cov_dup" ]; then
            dup_display=$(printf '%s' "$cov_dup" | tr '\n' ' ' | sed -e 's/[ \t]*$//')
            msg="${msg}; duplicated: ${dup_display}"
          fi
          findings+=("${msg}. ${DONT_READ}")
        fi
      fi
    fi
  fi

  # --- check 6: '## Ledger', once '## Topology' exists ---------------------
  ledger_line=$(first_line_matching "$plan" '^##[ \t]+Ledger[ \t]*$')
  if [ -z "$ledger_line" ]; then
    findings+=("'## Ledger' is missing from ${plan} even though '## Topology' is present — add a '## Ledger' section. ${DONT_READ}")
  fi
fi

# --- check 7: '## Moments', its bullets and their steps ---------------------
#
# Not flagged for being entirely absent, and a block whose only non-blank
# content is a bare '—' is the planner's own assertion that this work puts
# no new moment in front of anyone — also not a finding. Once the heading
# carries anything else, every top-level bullet must be a moment heading
# ('- **M-<n>. <text>** · US-<n>[, ...]') naming at least one 'US-'
# reference, and each must carry at least two numbered steps indented two
# spaces.

moments_line=$(first_line_matching "$plan" '^##[ \t]+Moments[ \t]*$')
if [ -n "$moments_line" ]; then
  moments_block=$(awk -v start="$moments_line" '
    /^```/ { fence = !fence; next }
    fence { next }
    NR == start { inmoments = 1; next }
    inmoments && /^##[ \t]+/ { exit }
    inmoments { print }
  ' "$plan")

  moments_nonblank=$(printf '%s\n' "$moments_block" | grep -v '^[ \t]*$' || true)

  if [ -n "$moments_nonblank" ] && [ "$moments_nonblank" != "—" ]; then
    moments_issues=$(printf '%s\n' "$moments_block" | awk '
      function flush(   ) {
        if (have) {
          if (valid) {
            if (steps < 2) print "SHORT\t" id "\t" steps
            if (!has_story) print "NOSTORY\t" id
          } else {
            print "BAD\t" line
          }
        }
      }
      /^-[ \t]/ {
        flush()
        have = 1
        line = $0
        steps = 0
        if (line ~ /^- \*\*M-[0-9]+\.[ \t]/) {
          valid = 1
          id = line
          sub(/^- \*\*M-/, "", id)
          sub(/\..*$/, "", id)
          id = "M-" id
          has_story = (line ~ /·[ \t]*US-[0-9]+/) ? 1 : 0
        } else {
          valid = 0
        }
        next
      }
      /^  [0-9]+\.[ \t]/ {
        if (have && valid) steps++
        next
      }
      END { flush() }
    ')

    if [ -n "$moments_issues" ]; then
      while IFS=$'\t' read -r m_kind m_a m_b; do
        [ -n "$m_kind" ] || continue
        case "$m_kind" in
          BAD)
            findings+=("'## Moments' in ${plan} has a bullet that is not a moment heading: '${m_a}' — expected the shape '- **M-<n>. <what the person is doing>** · US-<n>[, US-<n>...]'. ${DONT_READ}")
            ;;
          SHORT)
            findings+=("moment ${m_a} in ${plan} has ${m_b} numbered step(s) — a moment needs at least two, each written '  1. <step>' and indented exactly two spaces. A step indented any other way is not counted, which is why this can read 0 with steps on the page. ${DONT_READ}")
            ;;
          NOSTORY)
            findings+=("moment ${m_a} in ${plan} names no story — a moment names the stories (US-<n>) it gathers. ${DONT_READ}")
            ;;
        esac
      done <<< "$moments_issues"
    fi
  fi
fi

# --- check 8: every phase's '**Depends on**' is well-formed ----------------
#
# Numbered 8, not 5, so checks 1-7 keep the numbers the header comment, the
# existing manifest rows and their patch context already use. It belongs
# beside check 4 rather than after it: check 4 proves the field is there,
# check 8 proves it says something.
#
# No cycle detector, and none is wanted: a dependency bullet always names a
# lower-numbered phase and phase numbers are contiguous from 1 (check 3), so
# the graph is acyclic by construction and every reference resolves to a
# phase that exists. The one comparison below is the whole guarantee.
#
# A line inside the field that begins with whitespace is a wrapped bullet's
# continuation and is skipped, not reported; a blank line is skipped too.
# The field ends at the next bold field heading, the next phase heading, or
# the next '##'. The em dash is matched as a literal byte sequence, the way
# parallel-contract already matches '- —' — no character class, no locale
# assumption, no LC_ALL change.

depends_issues=$(awk '
  /^```/ { fence = !fence; next }
  fence { next }

  function reset_field() {
    infield = 0; has_dash = 0; has_dep = 0; content_lines = 0
    nbad = 0; nfwd = 0
  }

  function close_field(   i) {
    if (!infield) return
    if (content_lines == 0) {
      print "EMPTY\t" phase
    } else if (has_dash && has_dep) {
      print "MIXED\t" phase
    } else {
      for (i = 1; i <= nbad; i++) print "BAD\t" phase "\t" bad_line[i]
      for (i = 1; i <= nfwd; i++) print "FORWARD\t" phase "\t" fwd_n[i]
    }
  }

  BEGIN { reset_field() }

  /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    close_field()
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    phase = n + 0
    reset_field()
    next
  }

  /^##[ \t]+/ && $0 !~ /^###/ {
    close_field()
    reset_field()
    next
  }

  /^\*\*[A-Za-z][^*]*\*\*[ \t]*$/ {
    close_field()
    reset_field()
    if ($0 ~ /^\*\*Depends on\*\*[ \t]*$/) infield = 1
    next
  }

  infield {
    line = $0
    if (line ~ /^[ \t]*$/) next
    if (line ~ /^[ \t]+/) next
    content_lines++
    if (line ~ /^-[ \t]*—[ \t]*$/) { has_dash = 1; next }
    if (line ~ /^- phase [0-9]+ — .+$/) {
      has_dep = 1
      n2 = line
      sub(/^- phase /, "", n2)
      sub(/ —.*$/, "", n2)
      if ((n2 + 0) >= phase) { nfwd++; fwd_n[nfwd] = n2 + 0 }
      next
    }
    nbad++; bad_line[nbad] = line
  }

  END { close_field() }
' "$plan")

if [ -n "$depends_issues" ]; then
  while IFS=$'\t' read -r dp_kind dp_phase dp_extra; do
    [ -n "$dp_kind" ] || continue
    case "$dp_kind" in
      EMPTY)
        findings+=("phase ${dp_phase}'s **Depends on** in ${plan} is empty — write '- —' when the phase depends on nothing, or '- phase <n> — <why this phase needs its file>' for each phase whose file it edits. ${DONT_READ}")
        ;;
      BAD)
        findings+=("phase ${dp_phase}'s **Depends on** in ${plan} has a bullet that is not a dependency: '${dp_extra}' — expected '- phase <n> — <why this phase needs its file>', with an em dash and one space on either side, or a single '- —'. ${DONT_READ}")
        ;;
      FORWARD)
        findings+=("phase ${dp_phase}'s **Depends on** in ${plan} names phase ${dp_extra} — a dependency is always on an earlier phase, so the number must be lower than ${dp_phase}. A phase cannot depend on itself, or on one that runs after it. ${DONT_READ}")
        ;;
      MIXED)
        findings+=("phase ${dp_phase}'s **Depends on** in ${plan} carries both '- —' and a dependency — the dash is the assertion that there is none, so it stands alone or not at all. ${DONT_READ}")
        ;;
    esac
  done <<< "$depends_issues"
fi

# --- check 9: every phase's '**Verification**' names the join that proves it
#
# Check 8's twin, and deliberately built the same way: one fence-aware awk
# pass that walks phases and latches on '**Verification**', then one bash
# loop turning each 'KIND\tphase\textra' tuple into a sentence. The field
# ends at the next bold field heading, the next phase heading, or the next
# '##'; a blank line and a wrapped bullet's indented continuation are
# skipped, not reported. The em dash is matched as a literal byte sequence,
# the way check 8 and parallel-contract already match it.
#
# Reports only, never repairs: which join proves a phase is a decision, and
# check 1 stays the only repair in this script.

verification_issues=$(awk '
  /^```/ { fence = !fence; next }
  fence { next }

  function reset_field() {
    infield = 0; content_lines = 0
    n_proved = 0; n_joins = 0; n_cases = 0; nbad = 0
    proved_n = 0; joins_a = 0; joins_b = 0
  }

  function close_field(   i) {
    if (!infield) return
    nrec++
    rbuf[nrec] = ""
    rph[nrec] = phase
    rproved[nrec] = ""
    if (content_lines == 0) {
      rbuf[nrec] = "VEMPTY\t" phase "\t\n"
      return
    }
    if (n_proved > 0 && n_joins > 0) {
      rbuf[nrec] = "VMIXED\t" phase "\t\n"
      return
    }
    rproved[nrec] = (n_proved > 0 ? proved_n : "")
    if (n_joins == 0) {
      for (i = 1; i <= n_cases; i++) { nbad++; bad_line[nbad] = case_line[i] }
    }
    for (i = 1; i <= nbad; i++) rbuf[nrec] = rbuf[nrec] "VBAD\t" phase "\t" bad_line[i] "\n"
    if (n_joins > 0) {
      isjoin[phase] = 1
      if (n_cases == 0) rbuf[nrec] = rbuf[nrec] "VNOCASES\t" phase "\t" joins_a "-" joins_b "\n"
      if (joins_b >= phase || joins_a > joins_b) {
        rbuf[nrec] = rbuf[nrec] "VBACKWARD\t" phase "\t" joins_a "-" joins_b "\n"
      } else {
        range_a[phase] = joins_a; range_b[phase] = joins_b
      }
    }
  }

  BEGIN { reset_field(); nrec = 0 }

  /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    close_field()
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    phase = n + 0
    seen[phase] = 1
    reset_field()
    next
  }

  /^##[ \t]+/ && $0 !~ /^###/ {
    close_field()
    reset_field()
    next
  }

  /^\*\*[A-Za-z][^*]*\*\*[ \t]*$/ {
    close_field()
    reset_field()
    if ($0 ~ /^\*\*Verification\*\*[ \t]*$/) infield = 1
    next
  }

  infield {
    line = $0
    if (line ~ /^[ \t]*$/) next
    if (line ~ /^[ \t]+/) next
    content_lines++
    if (line ~ /^- proved by: phase [0-9]+[ \t]*$/) {
      n_proved++
      pn = line
      sub(/^- proved by: phase /, "", pn)
      proved_n = pn + 0
      next
    }
    if (line ~ /^- joins: phases [0-9]+-[0-9]+[ \t]*$/) {
      n_joins++
      jn = line
      sub(/^- joins: phases /, "", jn)
      split(jn, jr, "-")
      joins_a = jr[1] + 0; joins_b = jr[2] + 0
      next
    }
    if (line ~ /^- cases: —[ \t]*$/ || line ~ /^- cases: TC-[0-9]+(, TC-[0-9]+)*[ \t]*$/) {
      n_cases++; case_line[n_cases] = line
      next
    }
    nbad++; bad_line[nbad] = line
  }

  END {
    close_field()
    for (i = 1; i <= nrec; i++) {
      printf "%s", rbuf[i]
      if (rproved[i] == "") continue
      j = rproved[i] + 0
      if (j <= rph[i] || !(j in seen)) {
        printf "VFORWARD\t%s\t%s\n", rph[i], j
        continue
      }
      if (!(j in isjoin)) {
        printf "VNOJOIN\t%s\t%s\n", rph[i], j
        continue
      }
      if (j in range_a && (range_a[j] > rph[i] || range_b[j] < rph[i]))
        printf "VNOTCOVERED\t%s\t%s %s-%s\n", rph[i], j, range_a[j], range_b[j]
    }
  }
' "$plan")

if [ -n "$verification_issues" ]; then
  while IFS=$'\t' read -r v_kind v_phase v_extra; do
    [ -n "$v_kind" ] || continue
    case "$v_kind" in
      VEMPTY)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} is empty — write '- proved by: phase <n>' naming the join that proves this phase, or, if this phase is the join, '- joins: phases <a>-<b>' and '- cases: TC-<n>[, TC-<n>...]'. ${DONT_READ}")
        ;;
      VBAD)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} has a bullet that is neither form: '${v_extra}' — an ordinary phase's **Verification** is one '- proved by: phase <n>' bullet naming the join that proves it; a join's is '- joins: phases <a>-<b>' with '- cases: TC-<n>[, TC-<n>...]' or '- cases: —'. ${DONT_READ}")
        ;;
      VMIXED)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} carries both '- proved by:' and '- joins:' — a phase is one or the other: either a join proves it, or it is the join. ${DONT_READ}")
        ;;
      VFORWARD)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} names phase ${v_extra} as the join that proves it — a join is always later than what it proves, so the number must be higher than ${v_phase} and name a phase this plan has. ${DONT_READ}")
        ;;
      VBACKWARD)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} joins phases ${v_extra} — a join's range is always earlier than the join itself, so the last number must be lower than ${v_phase} and the first must not be higher than the last. ${DONT_READ}")
        ;;
      VNOJOIN)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} names phase ${v_extra} as the join that proves it, but phase ${v_extra} carries no '- joins: phases <a>-<b>' bullet, so it is not a join — a phase carrying '- joins:' is the join, and there is no other marker. ${DONT_READ}")
        ;;
      VNOTCOVERED)
        nc_join="${v_extra%% *}"
        nc_range="${v_extra#* }"
        findings+=("phase ${v_phase}'s **Verification** in ${plan} names phase ${nc_join} as the join that proves it, but phase ${nc_join} joins phases ${nc_range}, which does not cover phase ${v_phase} — a phase is proved by a join whose range contains it. ${DONT_READ}")
        ;;
      VNOCASES)
        findings+=("phase ${v_phase}'s **Verification** in ${plan} joins phases ${v_extra} but carries no '- cases:' bullet — a join names the approved cases it proves, as '- cases: TC-<n>[, TC-<n>...]', or '- cases: —' to assert it proves none. ${DONT_READ}")
        ;;
    esac
  done <<< "$verification_issues"
fi

# --- check 10: the Topology rows are the partition the joins induce --------
#
# ADR-0005: the join is the only barrier, and everything between two joins
# dispatches at once. So the rows are not authored — they are read off the
# joins, and a row boundary that is not a join is a barrier the model does
# not have. Walk the phases in order: a join closes the run of phases before
# it and stands alone; everything else accumulates.
#
# Reports only. Which phases are a join is a decision made in **Verification**,
# and rewriting someone's table from it is not this script's business.

row_span() {
  if [ "$1" = "$2" ]; then printf '%s' "$1"; else printf '%s-%s' "$1" "$2"; fi
}

if [ -n "$topology_line" ] && [ -n "${uniq_nums:-}" ]; then
  join_phases=$(awk '
    /^```/ { fence = !fence; next }
    fence { next }
    /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
      n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
      phase = n + 0; infield = 0; next
    }
    /^##[ \t]+/ && $0 !~ /^###/ { infield = 0; next }
    /^\*\*[A-Za-z][^*]*\*\*[ \t]*$/ {
      infield = ($0 ~ /^\*\*Verification\*\*[ \t]*$/) ? 1 : 0
      next
    }
    infield && /^- joins: phases [0-9]+-[0-9]+[ \t]*$/ { if (phase) print phase }
  ' "$plan" | LC_ALL=C sort -n -u)

  topo_rows=$(awk -v start="$topology_line" '
    /^```/ { fence = !fence; next }
    fence { next }
    NR == start { intopo = 1; next }
    intopo && /^##[ \t]+/ { exit }
    intopo && /^\|/ { print; started = 1; next }
    intopo && started { exit }
  ' "$plan" | tail -n +2 | awk -F'|' '
    {
      sep = 1
      for (i = 1; i <= NF; i++) {
        cell = $i; gsub(/^[ \t]+|[ \t]+$/, "", cell)
        if (cell != "" && cell !~ /^:?-+:?$/) sep = 0
      }
      if (sep) next
      c = $2; gsub(/^[ \t]+|[ \t]+$/, "", c)
      print c
    }
  ')

  actual_rows=""
  while IFS= read -r cell; do
    [ -n "$cell" ] || continue
    if [[ "$cell" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      actual_rows="${actual_rows}${actual_rows:+$'\n'}${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
    elif [[ "$cell" =~ ^[0-9]+$ ]]; then
      actual_rows="${actual_rows}${actual_rows:+$'\n'}${cell}-${cell}"
    else
      actual_rows="${actual_rows}${actual_rows:+$'\n'}?${cell}"
    fi
  done <<< "$topo_rows"

  last_phase=$(printf '%s\n' "$uniq_nums" | tail -1)
  expected_rows=""
  acc_lo=""
  for ((rp = 1; rp <= last_phase; rp++)); do
    if printf '%s\n' "$join_phases" | grep -qx -- "$rp"; then
      if [ -n "$acc_lo" ]; then
        expected_rows="${expected_rows}${expected_rows:+$'\n'}${acc_lo}-$((rp - 1))"
        acc_lo=""
      fi
      expected_rows="${expected_rows}${expected_rows:+$'\n'}${rp}-${rp}"
    elif [ -z "$acc_lo" ]; then
      acc_lo=$rp
    fi
  done
  if [ -n "$acc_lo" ]; then
    expected_rows="${expected_rows}${expected_rows:+$'\n'}${acc_lo}-${last_phase}"
  fi

  if [ -n "$join_phases" ] && [ "$actual_rows" != "$expected_rows" ]; then
    exp_display=""
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      exp_display="${exp_display}${exp_display:+, }$(row_span "${r%%-*}" "${r##*-}")"
    done <<< "$expected_rows"
    act_display=""
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      case "$r" in
        \?*) act_display="${act_display}${act_display:+, }'${r#\?}'" ;;
        *) act_display="${act_display}${act_display:+, }$(row_span "${r%%-*}" "${r##*-}")" ;;
      esac
    done <<< "$actual_rows"
    findings+=("the '## Topology' rows in ${plan} are ${act_display:-(none)}, but the joins in this plan induce ${exp_display} — the join is the only barrier, so every phase between two joins shares one row and every join stands alone. A boundary anywhere else is a barrier the model does not have. ${DONT_READ}")
  fi
fi

# --- check 11: every phase's '**Implementer**' names one model -------------
#
# Check 8's shape, on the field that replaced the Topology table's column:
# the model is a property of the work, not of the band it happens to land in.
# Exactly one bullet, naming Sonnet or Opus, alone or with its reason.

implementer_issues=$(awk '
  /^```/ { fence = !fence; next }
  fence { next }

  function close_field() {
    if (!infield) return
    if (content == 0) printf "IEMPTY\t%s\t\n", phase
    else if (content > 1) printf "IMULTI\t%s\t%s\n", phase, content
    infield = 0
  }

  /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    close_field()
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    phase = n + 0
    next
  }

  /^##[ \t]+/ && $0 !~ /^###/ { close_field(); next }

  /^\*\*[A-Za-z][^*]*\*\*[ \t]*$/ {
    close_field()
    if ($0 ~ /^\*\*Implementer\*\*[ \t]*$/) { infield = 1; content = 0 }
    next
  }

  infield {
    if ($0 ~ /^[ \t]*$/) next
    if ($0 ~ /^[ \t]+/) next
    content++
    if ($0 !~ /^- (Sonnet|Opus)([ \t]+—[ \t]+.+)?[ \t]*$/)
      printf "IBAD\t%s\t%s\n", phase, $0
  }

  END { close_field() }
' "$plan")

if [ -n "$implementer_issues" ]; then
  while IFS=$'\t' read -r i_kind i_phase i_extra; do
    [ -n "$i_kind" ] || continue
    case "$i_kind" in
      IEMPTY)
        findings+=("phase ${i_phase}'s **Implementer** in ${plan} is empty — write '- Sonnet' or '- Opus', optionally followed by ' — <why>'. There is no dash form here: every phase is built by something. ${DONT_READ}")
        ;;
      IMULTI)
        findings+=("phase ${i_phase}'s **Implementer** in ${plan} carries ${i_extra} bullets — a phase is built by one model, so the field holds exactly one. ${DONT_READ}")
        ;;
      IBAD)
        findings+=("phase ${i_phase}'s **Implementer** in ${plan} has a bullet that names no model: '${i_extra}' — expected '- Sonnet' or '- Opus', alone or followed by ' — <why>', with an em dash and one space on either side. ${DONT_READ}")
        ;;
    esac
  done <<< "$implementer_issues"
fi

# --- report ------------------------------------------------------------------

if [ "${#fixed[@]}" -gt 0 ]; then
  for line in "${fixed[@]}"; do
    echo "$line"
  done
fi

if [ "${#findings[@]}" -gt 0 ]; then
  for msg in "${findings[@]}"; do
    echo "$msg"
    echo
  done
  exit 1
fi

exit 0
