#!/usr/bin/env bash
# Puts the work on its own branch or worktree and reports what stands in the
# way. Fixes only what is unambiguous (the .ai-workflow exclude line, the
# .ai-workflow symlink in a worktree); judgement calls are reported and left to
# the caller.
#
# Usage: preflight [--worktree] [--from REF] [BRANCH]
# Exit:  0 clean
#        1 findings printed
#        2 not a git repository, or the arguments are wrong
set -uo pipefail

usage() { echo "usage: preflight [--worktree] [--from REF] [BRANCH]" >&2; exit 2; }

worktree="" from="" branch=""
while [ $# -gt 0 ]; do
  case "$1" in
    --worktree) worktree=1; shift ;;
    --from) [ $# -ge 2 ] || usage; from="$2"; shift 2 ;;
    -*) usage ;;
    *) [ -z "$branch" ] || usage; branch="$1"; shift ;;
  esac
done
[ -n "$branch" ] || { [ -z "$worktree" ] && [ -z "$from" ]; } || usage

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repository" >&2; exit 2; }
if [ -n "$branch" ] && ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
  echo "not a valid branch name: $branch" >&2
  exit 2
fi
common="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$(cd "$(git rev-parse --absolute-git-dir)" && pwd -P)" = "$common" ]; then
  main_checkout="$root"
else
  main_checkout="$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')"
fi

findings=()
add() { findings+=("$1"); }

def="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
if [ -z "$def" ]; then
  if   git show-ref --verify --quiet refs/heads/main;   then def="main"
  elif git show-ref --verify --quiet refs/heads/master; then def="master"
  fi
fi

env_field() {
  local contract="$1/CLAUDE.md"
  [ -f "$contract" ] || return 1
  grep -iE "^\*\*$2\.?\*\*" "$contract" | head -1 | sed -E "s/^\*\*[^*]*\*\*[[:space:]]*//"
}

backticked() {
  printf '%s\n' "$1" | grep -oE '`[^`]+`' | tr -d '`'
}

prepare_worktree() {
  local wt="$1" field cmd pattern src rel done_flag
  if [ ! -e "$wt/.ai-workflow" ] && [ -d "$main_checkout/.ai-workflow" ]; then
    ln -s "$main_checkout/.ai-workflow" "$wt/.ai-workflow"
    echo "fixed: linked .ai-workflow -> $main_checkout/.ai-workflow"
  fi

  if ! field="$(env_field "$wt" link)" || [ -z "$field" ]; then
    add "no 'link' field in CLAUDE.md's ## Environment — ask which untracked paths a fresh tree needs (default .env*), then record it"
  else
    while IFS= read -r pattern; do
      [ -n "$pattern" ] || continue
      for src in "$main_checkout"/$pattern; do
        [ -e "$src" ] || continue
        rel="${src#"$main_checkout"/}"
        [ -e "$wt/$rel" ] || { ln -s "$src" "$wt/$rel" && echo "linked: $rel"; }
      done
    done < <(backticked "$field")
  fi

  if ! field="$(env_field "$wt" bootstrap)" || [ -z "$field" ]; then
    add "no 'bootstrap' field in CLAUDE.md's ## Environment — ask how a fresh tree is prepared, then record it"
    return
  fi
  done_flag="$(git -C "$wt" rev-parse --absolute-git-dir)/devskills-bootstrapped"
  [ -e "$done_flag" ] && return
  cmd="$(backticked "$field" | head -1)"
  [ -n "$cmd" ] || return
  echo "bootstrap: $cmd"
  if (cd "$wt" && bash -c "$cmd") 2>&1 | sed 's/^/  /'; then
    : > "$done_flag"
  else
    add "bootstrap failed in $wt: $cmd — fix it and run preflight again"
  fi
}

record_base() {
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git config "branch.$branch.devskillsbase" "$(git rev-parse "$base^{commit}")"
    if [ -n "$from" ] && git show-ref --verify --quiet "refs/heads/$from"; then
      git config "branch.$branch.devskillsfrom" "$from"
    fi
  fi
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" \
    || [ -n "$(git for-each-ref --format='%(refname)' "refs/remotes/*/$1")" ]
}

tree="$root"
carried=""
if [ -n "$branch" ]; then
  base="${from:-$def}"
  if [ -z "$base" ] || ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
    echo "no base to branch from: ${base:-the default branch is unknown}" >&2
    exit 2
  fi
  git worktree prune
  existing="$(git worktree list --porcelain \
    | awk -v want="branch refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0==want{print w; exit}')"
  sibling="$(dirname "$main_checkout")/$(basename "$main_checkout").worktrees/${branch//\//-}"
  if [ -z "$existing" ] && [ -n "$worktree" ] \
     && git worktree list --porcelain | grep -qxF "worktree $sibling"; then
    held_dir="$(git -C "$sibling" rev-parse --absolute-git-dir 2>/dev/null)"
    held="$(cat "$held_dir/rebase-merge/head-name" "$held_dir/rebase-apply/head-name" 2>/dev/null | head -1)"
    [ -n "$held" ] || held="refs/heads/$(cat "$held_dir/BISECT_START" 2>/dev/null)"
    if [ "$held" != "refs/heads/$branch" ]; then
      echo "the worktree path $sibling holds another branch or a detached HEAD — check out $branch there, or name the branch differently" >&2
      exit 1
    fi
    existing="$sibling"
  fi

  if [ -n "$existing" ]; then
    tree="$existing"
    echo "resuming: $branch is checked out at $existing"
    [ "$existing" = "$main_checkout" ] || prepare_worktree "$tree"
  elif [ -n "$worktree" ]; then
    tree="$sibling"
    if [ -e "$tree" ]; then
      echo "the worktree path $tree already exists — remove it, or name the branch differently" >&2
      exit 1
    fi
    if branch_exists "$branch"; then
      out="$(git worktree add "$tree" "$branch" 2>&1)" || { echo "$out" >&2; exit 1; }
    else
      out="$(git worktree add --no-track -b "$branch" "$tree" "$base" 2>&1)" || fail_out="$out"
      record_base
      [ -z "${fail_out:-}" ] || { echo "$fail_out" >&2; exit 1; }
    fi
    echo "worktree: $tree — work there"
    prepare_worktree "$tree"
  else
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
      carried="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "--detach $(git rev-parse --short HEAD)")"
    fi
    if branch_exists "$branch"; then
      out="$(git switch "$branch" 2>&1)" || { echo "$out" >&2; exit 1; }
    else
      out="$(git switch --no-track -c "$branch" "$base" 2>&1)" || fail_out="$out"
      record_base
      [ -z "${fail_out:-}" ] || { echo "$fail_out" >&2; exit 1; }
    fi
  fi
fi

gitdir="$(git -C "$tree" rev-parse --git-dir)"
case "$gitdir" in /*) ;; *) gitdir="$tree/$gitdir" ;; esac
[ -f "$gitdir/MERGE_HEAD" ]       && add "merge in progress — finish or abort it first"
[ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] \
                                  && add "rebase in progress — finish or abort it first"
[ -f "$gitdir/CHERRY_PICK_HEAD" ] && add "cherry-pick in progress — finish or abort it"
[ -f "$gitdir/REVERT_HEAD" ]      && add "revert in progress — finish or abort it"
[ -f "$gitdir/BISECT_LOG" ]       && add "bisect in progress — 'git bisect reset' first"

current="$(git -C "$tree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$current" ]; then
  add "detached HEAD — commits here belong to no branch"
elif [ -n "$def" ] && [ "$current" = "$def" ]; then
  add "on the default branch ($def) — put the work on its own: preflight feat/<unit>, or --worktree"
fi

staged="$(git -C "$tree" diff --cached --name-only | wc -l | tr -d ' ')"
unstaged="$(git -C "$tree" diff --name-only | wc -l | tr -d ' ')"
if [ "$staged" -eq 0 ] && [ "$unstaged" -eq 0 ]; then
  :
elif [ -n "$carried" ]; then
  add "uncommitted changes (${staged} staged, ${unstaged} unstaged) came along from ${carried#--detach } — if they are not this work, 'git switch $carried' and cut with --worktree"
else
  add "uncommitted changes (${staged} staged, ${unstaged} unstaged) — if they are not this work, use --worktree"
fi

if [ -n "$def" ] && [ -n "$current" ] && [ "$current" != "$def" ]; then
  head="$(git -C "$tree" rev-parse HEAD)"
  {
    git config --get "branch.$current.devskillsfrom" 2>/dev/null
    git for-each-ref --format='%(refname:short)' refs/heads/ | while IFS= read -r other; do
      [ "$other" != "$current" ] && [ "$other" != "$def" ] || continue
      [ "$(git rev-parse "refs/heads/$other")" != "$head" ] || continue
      git merge-base --is-ancestor "refs/heads/$other" "$head" && echo "$other"
    done
  } | awk 'NF && !seen[$0]++' | while IFS= read -r other; do
    git show-ref --verify --quiet "refs/heads/$other" || continue
    git merge-base --is-ancestor "refs/heads/$other" "$def" \
      || echo "note: stacked on $other, which has not landed on $def; finish it first"
  done
fi

exclude="$common/info/exclude"
if ! git -C "$tree" check-ignore -q .ai-workflow && ! grep -qxF .ai-workflow "$exclude" 2>/dev/null; then
  mkdir -p "$common/info"
  if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then printf '\n' >> "$exclude"; fi
  printf '.ai-workflow\n' >> "$exclude"
  echo "fixed: added .ai-workflow to $exclude"
fi

echo "tree: $tree"
echo "branch: ${current:-detached}${def:+ (default: $def)}"
recorded="$(git -C "$tree" config --get "branch.$current.devskillsbase" 2>/dev/null || true)"
[ -z "$recorded" ] || echo "base: $recorded"
if [ ${#findings[@]} -eq 0 ]; then
  echo "preflight clean"
  exit 0
fi
for f in "${findings[@]}"; do printf '  - %s\n' "$f"; done
exit 1
